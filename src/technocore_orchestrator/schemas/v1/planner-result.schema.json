{
  "$defs": {
    "ChallengeDisposition": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "accepted",
            "rejected"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "disposition",
        "rationale"
      ],
      "title": "ChallengeDisposition",
      "type": "object"
    },
    "PlanStep": {
      "additionalProperties": false,
      "properties": {
        "criterion_ids": {
          "items": {
            "type": "string"
          },
          "title": "Criterion Ids",
          "type": "array"
        },
        "description": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "expected_paths": {
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "title": "Expected Paths",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "expected_paths",
        "criterion_ids"
      ],
      "title": "PlanStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "blocked_reason": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Blocked Reason"
    },
    "challenge_dispositions": {
      "items": {
        "$ref": "#/$defs/ChallengeDisposition"
      },
      "title": "Challenge Dispositions",
      "type": "array"
    },
    "risks": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/PlanStep"
      },
      "title": "Steps",
      "type": "array"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "verification_suggestions": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Verification Suggestions",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "steps",
    "risks",
    "verification_suggestions",
    "challenge_dispositions",
    "blocked_reason"
  ],
  "title": "PlannerResult",
  "type": "object"
}
